# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qa_guardian

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Magic Link
MAGIC_LINK_SECRET=your-magic-link-secret-change-in-production
MAGIC_LINK_EXPIRES_IN=15m

# Email (optional - for magic links and alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=qa-guardian@example.com

# Slack (optional - for alerts)
SLACK_WEBHOOK_URL=

# S3 Storage (for screenshots/videos/reports)
S3_ENDPOINT=
S3_BUCKET=qa-guardian
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Test Target
TARGET_BASE_URL=https://casacarigar.com

# Scheduler (cron expressions)
DAILY_SCHEDULE=0 7 * * *
WEEKLY_SCHEDULE=0 10 * * 0
TIMEZONE=Asia/Kolkata
