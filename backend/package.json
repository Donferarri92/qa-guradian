{
    "name": "qa-guardian-backend",
    "version": "1.0.0",
    "description": "QA Guardian Backend API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/server.js",
        "test": "vitest run",
        "lint": "eslint src/",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts"
    },
    "dependencies": {
        "@netlify/functions": "^5.1.2",
        "@prisma/client": "^5.10.0",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "ioredis": "^5.3.2",
        "jose": "^5.2.0",
        "nodemailer": "^6.9.8",
        "pdfkit": "^0.14.0",
        "serverless-http": "^4.0.0",
        "uuid": "^9.0.1",
        "winston": "^3.11.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.10",
        "@types/nodemailer": "^6.4.14",
        "@types/pdfkit": "^0.17.4",
        "@types/uuid": "^9.0.7",
        "eslint": "^8.56.0",
        "prisma": "^5.10.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vitest": "^1.2.2"
    }
}