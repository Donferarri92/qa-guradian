# QA Guardian Production Environment Variables
# Copy this file to .env and fill in your values

# Database - PostgreSQL connection URL
DATABASE_URL=postgresql://user:password@host:5432/qabot

# Redis - For job queue
REDIS_URL=redis://localhost:6379

# JWT Secret - Generate a secure random string
JWT_SECRET=your-super-secret-jwt-key-change-me

# Email Alerts (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
ALERT_EMAIL=qa-alerts@example.com

# S3 for Screenshots (Optional)
S3_BUCKET=qa-guardian-screenshots
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Fly.io Specific (if deploying to Fly.io)
FLY_APP_NAME=qa-guardian
